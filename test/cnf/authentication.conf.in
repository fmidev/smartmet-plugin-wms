database:
{
	# Use /etc/hosts to define smartmet-test is localhost or wherever the database is
	host		= "smartmet-test";
	port		= 5444;
	database	= "authentication";
	schema		= "authengine_test";
	auth_table	= "apikey_authorization";
	token_table	= "apikey_authorization_tokens";

	username	= "auth_user";
	password	= "auth_pw";

	update_interval_seconds = 5;

}

# The test database has no access rules for WMS, and since the engine fails closed
# for unknown services an apikey would otherwise hide every layer
default_access_is_allow = true;
