// OSM engine configuration for the WMS plugin tests.
//
// The extract dataset is a small OpenStreetMap extract committed with the
// tests (Helsinki in detail, the world coarsely). The tests use nothing else,
// since the full data is not available in CI.

styles = "osm/styles";
rescan_interval = 0;
min_file_age = 0;

datasets:
{
	extract: { directory = "osm/data/extract"; };
};
