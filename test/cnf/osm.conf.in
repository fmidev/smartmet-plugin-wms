// OSM engine configuration for the WMS plugin tests.
//
// The synthetic dataset is generated by osm/make_fixture.py and is always
// available. Real OpenStreetMap data is not distributed with the tests: the
// osmdata_* tests are run only if @OSM_DATA_DIR@/protomaps exists, see
// osm/README.md.

directory = "@OSM_DATA_DIR@";
styles = "osm/styles";
rescan_interval = 0;
min_file_age = 0;

datasets:
{
	synthetic: { directory = "osm/data/synthetic"; };
};
