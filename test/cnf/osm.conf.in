// OSM engine configuration for the WMS plugin tests.
//
// The extract dataset is a small OpenStreetMap extract committed with the
// tests (Helsinki in detail, the world coarsely) and is always available.
// The full_global_osm_* tests use the full data and are run only if
// @OSM_DATA_DIR@/protomaps exists, see osm/README.md.

directory = "@OSM_DATA_DIR@";
styles = "osm/styles";
rescan_interval = 0;
min_file_age = 0;

datasets:
{
	extract: { directory = "osm/data/extract"; };
};
