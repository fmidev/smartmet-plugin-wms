{
    "title": "The IFS pressure forecast used as the background",
    "producer": "ifs_europe",
    "projection": {
        "crs": "EPSG:3035",
        "bboxcrs": "EPSG:3035",
        "bbox": "2000000,1200000,7000000,5600000",
        "xsize": 500,
        "ysize": 440
    },
    "views": [
        {
            "qid": "v1",
            "layers": [
                {
                    "qid": "l1",
                    "layer_type": "isoband",
                    "isobands": "json:isobands/pressure.json",
                    "css": "isobands/pressure.css",
                    "parameter": "Pressure",
                    "attributes": {
                        "id": "pressure_isobands"
                    }
                },
                {
                    "qid": "l2",
                    "layer_type": "isoline",
                    "isolines": "json:isolines/pressure.json",
                    "css": "isolines/pressure.css",
                    "parameter": "Pressure",
                    "attributes": {
                        "id": "pressure_isolines",
                        "class": "Pressure"
                    }
                },
                {
                    "qid": "m1",
                    "layer_type": "map",
                    "map": {
                        "schema": "natural_earth",
                        "table": "admin_0_countries",
                        "minarea": 100
                    },
                    "attributes": {
                        "id": "coastlines",
                        "fill": "none",
                        "stroke": "#222",
                        "stroke-width": "0.3px"
                    }
                },
                {
                    "qid": "obs",
                    "layer_type": "symbol",
                    "producer": "europe_observations",
                    "parameter": "Pressure",
                    "symbols": "json:obsgrid/pressure_markers.json",
                    "css": "isobands/pressure.css",
                    "positions": {
                        "layout": "data"
                    }
                }
            ]
        }
    ]
}
