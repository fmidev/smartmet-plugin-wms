{
    "title": "Temperature observations gridded with the terrain",
    "producer": "synop_europe",
    "projection":
    {
	"crs": "data",
	"xsize": 500,
	"ysize": 440
    },
    "views": [
        {
	    "qid": "v1",
            "layers": [
                {
		    "qid": "l1",
                    "layer_type": "isoband",
