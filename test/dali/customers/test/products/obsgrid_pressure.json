{
    "title": "Pressure observations gridded with the plain Barnes method",
    "producer": "synop_europe",
    "projection":
    {
	"crs": "EPSG:3035",
	"bboxcrs": "EPSG:3035",
	"bbox": "2010000,1210000,6990000,5590000",
	"xsize": 1024,
	"ysize": 901
    },
    "views": [
        {
	    "qid": "v1",
            "layers": [
                {
		    "qid": "l1",
                    "layer_type": "isoband",
                    "isobands": "json:isobands/pressure.json",
		    "css": "isobands/pressure.css",
                    "parameter": "Pressure",
		    "attributes":
		    {
			"id": "pressure_isobands"
		    }
                },
                {
		    "qid": "l2",
                    "layer_type": "isoline",
                    "isolines": "json:isolines/pressure.json",
		    "css": "isolines/pressure.css",
                    "parameter": "Pressure",
		    "attributes":
		    {
			"id": "pressure_isolines",
			"class": "Pressure"
		    }
                },
                {
		    "qid": "m1",
                    "layer_type": "map",
                    "map":
                    {
			"schema": "natural_earth",
			"table": "admin_0_countries",
			"minarea": 100
                    },
		    "attributes":
		    {
			"id": "europe_coastlines",
			"fill": "none",
			"stroke": "#222",
			"stroke-width": "0.3px"
		    }
                },
                {
                    "qid": "obs",
                    "layer_type": "symbol",
                    "producer": "synop",
                    "parameter": "Pressure",
                    "symbols": "json:obsgrid/pressure_markers.json",
                    "css": "isobands/pressure.css",
                    "positions": { "layout": "data" }
                }
            ]
        }
    ]
}
