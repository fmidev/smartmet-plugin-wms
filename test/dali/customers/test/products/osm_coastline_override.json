                },
                {
                    "qid": "land",
                    "layer_type": "osm",
                    "dataset": "extract",
                    "style": "land-lakes-lightgray"
                },
                {
                    "qid": "coast",
                    "layer_type": "osm",
                    "dataset": "extract",
                    "style": "coastline-lakes-black",
                    "override": {
                        "stroke": "#c00000",
                        "stroke-width": 2,
                        "stroke-opacity": 0.8
                    }
                }
            ]
        }
    ]
}
