{
    "title": "Coastline and lake shores with the colour and width overridden",
    "projection": {
        "qid": "p",
        "crs": "EPSG:3067",
        "bboxcrs": "EPSG:3067",
        "bbox": "365000,6657000,410000,6694500",
        "xsize": 600,
        "ysize": 500
