{
    "title": "Weather data between an OpenStreetMap background and its labels",
    "projection":
    {
	"qid": "p",
	"crs": "EPSG:3067",
	"bboxcrs": "EPSG:3067",
	"bbox": "365000,6657000,410000,6694500",
	"xsize": 600,
	"ysize": 500
    },
    "views":
    [
	{
	    "qid": "v1",
	    "layers":
	    [
		{
		    "qid": "base",
		    "layer_type": "osm",
		    "dataset": "extract",
		    "style": "meteo-light",
		    "exclude": ["places_*", "boundaries*", "water_label_*"]
		},
		{
		    "qid": "data",
		    "layer_type": "wkt",
		    "wkt": "POLYGON((24.85 60.12,25.1 60.12,25.1 60.25,24.85 60.25,24.85 60.12))",
		    "resolution": 10,
		    "attributes":
		    {
			"fill": "#3070d0",
			"fill-opacity": "0.5"
		    }
		},
		{
		    "qid": "labels",
		    "layer_type": "osm",
		    "dataset": "extract",
		    "style": "meteo-light",
		    "include": ["places_*", "boundaries*", "water_label_*"],
		    "attribution": true
		}
	    ]
	}
    ]
}
