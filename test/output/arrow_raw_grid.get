<svg width="300" height="500" xmlns="http://www.w3.org/2000/svg" xmlns:xlink="http://www.w3.org/1999/xlink">
<title>Arrows of grid data with the .raw suffix</title>
<defs>
<style type="text/css"><![CDATA[


 ]]>
</style>
<symbol id="windarrow" overflow="visible">
 <desc>Plain wind arrow (north wind)</desc>
 <path d="M0 -6 -3 -2 -1 -2 -1 4 1 4 1 -2 3 -2Z"/>
</symbol>


</defs>

<g>
 <g>
  <g>
   <use transform="translate(30 30) rotate(240)" xlink:href="#windarrow"/>
   <use transform="translate(110 30) rotate(70)" xlink:href="#windarrow"/>
   <use transform="translate(190 30) rotate(120)" xlink:href="#windarrow"/>
   <use transform="translate(270 30) rotate(130)" xlink:href="#windarrow"/>
   <use transform="translate(30 110) rotate(270)" xlink:href="#windarrow"/>
   <use transform="translate(110 110) rotate(20)" xlink:href="#windarrow"/>
   <use transform="translate(190 110) rotate(140)" xlink:href="#windarrow"/>
   <use transform="translate(270 110) rotate(140)" xlink:href="#windarrow"/>
   <use transform="translate(30 190) rotate(280)" xlink:href="#windarrow"/>
   <use transform="translate(110 190) rotate(240)" xlink:href="#windarrow"/>
   <use transform="translate(190 190) rotate(220)" xlink:href="#windarrow"/>
   <use transform="translate(270 190) rotate(190)" xlink:href="#windarrow"/>
   <use transform="translate(30 270) rotate(260)" xlink:href="#windarrow"/>
   <use transform="translate(110 270) rotate(240)" xlink:href="#windarrow"/>
   <use transform="translate(190 270) rotate(250)" xlink:href="#windarrow"/>
   <use transform="translate(270 270) rotate(230)" xlink:href="#windarrow"/>
   <use transform="translate(30 350) rotate(240)" xlink:href="#windarrow"/>
   <use transform="translate(110 350) rotate(260)" xlink:href="#windarrow"/>
   <use transform="translate(190 350) rotate(260)" xlink:href="#windarrow"/>
   <use transform="translate(270 350) rotate(250)" xlink:href="#windarrow"/>
   <use transform="translate(30 430) rotate(240)" xlink:href="#windarrow"/>
   <use transform="translate(110 430) rotate(260)" xlink:href="#windarrow"/>
   <use transform="translate(190 430) rotate(260)" xlink:href="#windarrow"/>
   <use transform="translate(270 430) rotate(260)" xlink:href="#windarrow"/>
  </g>
 </g>
</g>

</svg>
